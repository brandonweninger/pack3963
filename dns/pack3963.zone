$ORIGIN pack3963.com.
$TTL 3600

; Pack 3963 DNS Zone File for Cloudflare Import
; GitHub Pages Configuration

@                    IN  SOA ns1.cloudflare.com. dns.cloudflare.com. (
                         2026091301  ; serial
                         10800       ; refresh (3 hours)
                         3600        ; retry (1 hour)
                         604800      ; expire (1 week)
                         3600        ; minimum TTL
                         )

; Nameservers
@                    IN  NS  ns1.cloudflare.com.
@                    IN  NS  ns2.cloudflare.com.

; Root domain - A records for GitHub Pages
@                    IN  A   185.199.108.153
@                    IN  A   185.199.109.153
@                    IN  A   185.199.110.153
@                    IN  A   185.199.111.153

; IPv6 support
@                    IN  AAAA 2606:50c0:8000::153
@                    IN  AAAA 2606:50c0:8001::153
@                    IN  AAAA 2606:50c0:8002::153
@                    IN  AAAA 2606:50c0:8003::153

; WWW subdomain - CNAME to GitHub Pages
www                  IN  CNAME brandonweninger.github.io.

; MX records (if needed for email)
; @                    IN  MX  10 mail.pack3963.com.

; TXT records (for domain verification, SPF, etc.)
; @                    IN  TXT "v=spf1 -all"
